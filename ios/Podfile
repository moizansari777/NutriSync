ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# platform :ios, min_ios_version_supported
platform :ios, 15.5
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

pre_install do |installer|
  installer.pod_targets.each do |pod|
    if pod.name.start_with?('RNFB')
      def pod.build_type
        Pod::BuildType.static_library
      end
    end
  end
end

target 'FoodScane' do
  config = use_native_modules!
  
  use_frameworks! :linkage => :static
  
  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # MLKit's podspecs exclude arm64 for the simulator, which leaves the
    # Pods-FoodScane aggregate target with no architecture to build on
    # Apple Silicon ("framework 'Pods_FoodScane' not found"). Its arm64
    # slices carry no platform metadata, so they link fine on the
    # simulator — drop the exclusion from the generated xcconfigs.
    Dir.glob(File.join(installer.sandbox.target_support_files_root, '**', '*.xcconfig')).each do |file|
      contents = File.read(file)
      patched = contents.gsub(/^EXCLUDED_ARCHS\[sdk=iphonesimulator\*\] = arm64\n?/, '')
      File.write(file, patched) unless patched == contents
    end

    # ...and strip the device-only platform tag from MLKit's static
    # binaries so they link against the arm64 simulator (see script).
    system('python3', File.join(__dir__, 'scripts', 'patch_mlkit_simulator.py')) or
      raise 'patch_mlkit_simulator.py failed'
  end
end
